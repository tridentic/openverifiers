# A rule whose conclusion is defined by its own absence.
package bench.barber_paradox
type Man
predicate resident(x: Man) world closed
predicate shaves_self(x: Man) world closed
axiom paradox(x: Man): resident(x), not shaves_self(x) -> shaves_self(x)

test barber_paradox {
  scenario barber_paradox_s uses bench.barber_paradox {
    entity a: Man
    fact resident(a)
    query PROVE shaves_self(a)
  }
}
