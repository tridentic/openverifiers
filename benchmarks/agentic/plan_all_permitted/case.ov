# Policy: never write outside the workspace.
package bench.plan_all_permitted
type Plan
type Action
type Thing
predicate plan(p: Plan) world closed
predicate step(p: Plan, i: Number, a: Action, x: Thing) world closed
predicate violation(p: Plan, i: Number) world closed
predicate violates(p: Plan) world closed
predicate valid(p: Plan) world closed
axiom any_violation(p: Plan, i: Number): violation(p, i) -> violates(p)
axiom valid_plan(p: Plan): plan(p), not violates(p) -> valid(p)
predicate in_workspace(x: Thing) world closed
entity write, read: Action
axiom outside_write(p: Plan, i: Number, x: Thing): step(p, i, write, x), not in_workspace(x) -> violation(p, i)

test plan_all_permitted {
  scenario plan_all_permitted_s uses bench.plan_all_permitted {
    entity build: Plan
    entity src, out: Thing
    fact plan(build)
    fact in_workspace(src)
    fact in_workspace(out)
    fact step(build, 1, read, src)
    fact step(build, 2, write, out)
    query PROVE valid(build)
  }
}
