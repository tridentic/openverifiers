    {
      "id": "claim_a212b8109b674f4c9dbd562fa9326455",
      "statement": "verify_physics is the SDK domain driver that wires the full pipeline: parse_problem to extract unverified_truth givens plus target kind, then Engine(get_physics_rules()) with make_target_fact and engine.deduce(givens, target); engine construction and rule loading happen inside the driver, never in the CLI.",
      "evidence": [
