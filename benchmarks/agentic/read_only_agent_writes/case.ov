# Policy: an agent with a read-only role may not write.
package bench.read_only_agent_writes
import agent.workflow
type Agent
predicate runs(p: Plan, ag: Agent) world closed
predicate read_only(ag: Agent) world closed
entity write, read: Tool
axiom ro_write(p: Plan, i: Number, x: Target, ag: Agent):
  step(p, i, write, x), runs(p, ag), read_only(ag) -> violation(p, i)

test read_only_agent_writes {
  scenario read_only_agent_writes_s uses bench.read_only_agent_writes {
    entity audit: Plan
    entity viewer: Agent
    entity ledger: Target
    fact plan(audit)
    fact runs(audit, viewer)
    fact read_only(viewer)
    fact step(audit, 1, read, ledger)
    fact step(audit, 2, write, ledger)
    query PROVE valid(audit)
    query FIND ?i WHERE violation(audit, ?i)
  }
}
