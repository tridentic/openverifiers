# KDScript-Domain — business scenario arithmetic (compound value).
# Money is USD; rate and years are dimensionless shares, step-bound params.

domain business {
    unit: USD, dimless

    type money { value: quantity<USD> }

    relation business.compound {
        inputs: { principal: money, fv: money, rate_pct: dimless, years: dimless }
        equation: fv == principal * (1 + rate_pct/100)**years
        param: [rate_pct, years]
        out: fv
    }

    # a guarded wrapper: compounding a non-positive principal is refused up front
    transform business.compound_guarded {
        relation: business.compound
        guard: [positive(principal)]
    }
}