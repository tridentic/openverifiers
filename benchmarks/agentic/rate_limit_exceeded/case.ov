# Policy: at most 3 calls to the paid API per plan (calls are numbered).
package bench.rate_limit_exceeded
import agent.workflow
predicate call_number(p: Plan, i: Number, k: Number) world closed
entity call_api: Tool
axiom over_limit(p: Plan, i: Number, k: Number): call_number(p, i, k), k > 3 -> violation(p, i)

test rate_limit_exceeded {
  scenario rate_limit_exceeded_s uses bench.rate_limit_exceeded {
    entity batch: Plan
    entity api: Target
    fact plan(batch)
    fact call_number(batch, 1, 1)
    fact call_number(batch, 2, 2)
    fact call_number(batch, 4, 3)
    fact call_number(batch, 5, 4)
    query FIND ?i WHERE violation(batch, ?i)
  }
}
