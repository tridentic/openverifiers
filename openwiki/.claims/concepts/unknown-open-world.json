    {
      "id": "claim_8984e5de8f39464fbaff01ee65d61130",
      "statement": "The Unknown node's semantics are grounded in the Description Logic Open-World Assumption (OWA): a formula is true only if entailed, everything not entailed is unknown, and absence of a fact in the ABox never licenses 'false'. This is the semantics of an incomplete information source, right for verifying AI claims.",
      "evidence": [
        {
          "resource": "repo://docs/research/03-dl-abox-tbox.md#L57-L60",
