# DRAFT (MP-DOL): AI-drafted library lines, not approved by the founder. Loaded only by
# `ov run --drafts` / `ov exam --drafts`; results that use it are provisional.
#
# physics.rotation: rigid bodies turning about a fixed axis.
package physics.rotation @0.1-draft

# Small oscillations about a fixed axis under a restoring torque -kappa theta, with
# angular frequency omega. This class carries no equation of motion, so object
# queries over it stay polynomial (an equation with cos(omega t) in it cannot be
# re-checked numerically); TorsionMotion below derives omega^2 I = kappa.
fact type AngularOscillator {
  property inertia: "kg*m^2"
  property kappa: "N*m"
  property omega: Frequency
  invariant positive: inertia > 0 kappa > 0 omega > 0
}

# The motion theta(t) = amplitude cos(omega t), released from rest at the angle
# `amplitude` at t = 0 (an idealised small oscillation: the torque is linear in
# theta). Newton's second law for rotation, I theta'' = -kappa theta, holds at every
# instant, in particular at the release: I theta''(0) = -kappa theta(0). With
# theta(0) = amplitude > 0 that gives omega^2 I = kappa: N043 is a theorem
# (packet 2: derivable).
fact type TorsionMotion extends AngularOscillator {
  property amplitude: Real
  property t: Time
  invariant amplitude_positive: amplitude > 0
  law newton_rotation_at_release:
    inertia * value_at(deriv(deriv(amplitude * cos(omega * t), t), t), t, 0)
    = -kappa * value_at(amplitude * cos(omega * t), t, 0)
  theorem small_oscillation: omega * omega * inertia = kappa
}
