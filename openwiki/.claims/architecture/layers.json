    {
      "id": "claim_10826b0abcdf41d89e2bfdb11fc2bf32",
      "statement": "When parse_problem cannot identify a target kind, verify_physics short-circuits to a synthetic UNKNOWN VerificationResult whose evidence note instructs the user to 'phrase your target as find the <quantity>'.",
      "evidence": [
