# Policy: never write outside the workspace.
package bench.plan_all_permitted
import agent.workflow
predicate in_workspace(x: Target) world closed
entity write, read: Tool
axiom outside_write(p: Plan, i: Number, x: Target): step(p, i, write, x), not in_workspace(x) -> violation(p, i)

test plan_all_permitted {
  scenario plan_all_permitted_s uses bench.plan_all_permitted {
    entity build: Plan
    entity src, out: Target
    fact plan(build)
    fact in_workspace(src)
    fact in_workspace(out)
    fact step(build, 1, read, src)
    fact step(build, 2, write, out)
    query PROVE valid(build)
  }
}
