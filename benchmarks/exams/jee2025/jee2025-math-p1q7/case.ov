# JEE (Advanced) 2025, paper 1, mathematics Q7 (see list.json). Formalization only.
#
# z1 = 1 + 2i, z2 = 3i; S = {(x, y) : |x + iy - z1| = 2 |x + iy - z2|}. Which are
# true: (A) S is a circle with centre (-1/3, 10/3); (B) S is a circle with centre
# (1/3, 8/3); (C) S is a circle with radius sqrt(2)/3; (D) S is a circle with
# radius 2 sqrt(2)/3.
# Transcription: |x + iy - (a + bi)| is the distance from (x, y) to (a, b); the
# condition is squared (both sides are non-negative). "S is a circle with centre
# c" is read as: every two points of S are equally far from c; "with radius r":
# every point of S is at distance r from the centre named in (A) or (B) for which
# that holds (here the one of (A), which (A)'s query establishes).
package bench.jee2025_math_p1q7

fact type TwoPointsOfS {
  property x1: Real
  property y1: Real
  property x2: Real
  property y2: Real
  invariant first_in_S: (x1 - 1) ^ 2 + (y1 - 2) ^ 2 = 4 * (x1 ^ 2 + (y1 - 3) ^ 2)
  invariant second_in_S: (x2 - 1) ^ 2 + (y2 - 2) ^ 2 = 4 * (x2 ^ 2 + (y2 - 3) ^ 2)
  theorem centre_A: (x1 + 1/3) ^ 2 + (y1 - 10/3) ^ 2 = (x2 + 1/3) ^ 2 + (y2 - 10/3) ^ 2
  theorem centre_B: (x1 - 1/3) ^ 2 + (y1 - 8/3) ^ 2 = (x2 - 1/3) ^ 2 + (y2 - 8/3) ^ 2
  theorem radius_C: (x1 + 1/3) ^ 2 + (y1 - 10/3) ^ 2 = 2 / 9
  theorem radius_D: (x1 + 1/3) ^ 2 + (y1 - 10/3) ^ 2 = 8 / 9
}

scenario jee2025_math_p1q7 uses bench.jee2025_math_p1q7 {
  query COUNTEREXAMPLE TwoPointsOfS.centre_A
  query COUNTEREXAMPLE TwoPointsOfS.centre_B
  query COUNTEREXAMPLE TwoPointsOfS.radius_C
  query COUNTEREXAMPLE TwoPointsOfS.radius_D
}
