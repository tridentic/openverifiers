# Policy: network fetches only from allowlisted hosts.
package bench.network_allowlist
import agent.workflow
predicate allowlisted(x: Target) world closed
entity fetch: Tool
axiom off_list(p: Plan, i: Number, x: Target): step(p, i, fetch, x), not allowlisted(x) -> violation(p, i)

test network_allowlist {
  scenario network_allowlist_s uses bench.network_allowlist {
    entity sync: Plan
    entity docs_host, paste_site: Target
    fact plan(sync)
    fact allowlisted(docs_host)
    fact step(sync, 1, fetch, docs_host)
    fact step(sync, 2, fetch, paste_site)
    query FIND ?i WHERE violation(sync, ?i)
  }
}
