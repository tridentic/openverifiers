# KDScript-Domain — English: a judged step, not a rule.
# The agreement check is MODEL-BACKED: document names a judge backend + output
# schema; engine stamps the result at the "judged" tier. Backend today is a
# deterministic stub (kern/judged.py); Jev plugs in behind the same registry.

domain english {
    type claim { kind: claim }

    judge english.agreement {
        model: stub-english
        input: [subject: claim, object: claim]
        schema: verdict: enum(consistent|inconsistent)
    }
}