# KDScript-Domain — core logic: propositional + basic predicate inference.
# The SAME core builtins math uses serve a non-numeric domain untouched.

domain logic {
    unit: dimless

    fact prop { kind: proposition }

    transform logic.modus_ponens {
        builtin: logic.modus_ponens
        input: [implication: prop, antecedent: prop]
    }
    transform logic.theorem_base {
        builtin: theorem_base
        param: [n, expr]
    }
    transform logic.theorem_step {
        builtin: theorem_step
        param: [k, expr]
        input: [predecessor: prop]
    }
    transform logic.induction_combine {
        builtin: induction_combine
        param: [variable, expr]
        input: [base: prop, step: prop]
    }

    exclusive: (true, false)
}