# KDScript-Domain — statute-element checklist (law/ethics slice).
# Contested facts stay on the extracted trust tier; the conjunction decides.

domain law {
    type allegation { kind: allegation }
    type element { kind: element }

    transform law.element_met {
        builtin: element_met
        param: [statute, element]
        input: [allegation: allegation]
    }
    transform law.all_elements {
        builtin: all_elements
        param: [statute]
    }
}