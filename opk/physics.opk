# KDScript-Domain — physics relations (exported from domains/physics_primitives.py; regenerate with `python -m kerscript.export`)

domain physics {

    unit: A, C, F, Hz, J, K, N, N/m, Pa, T, V, W, Wb, area, dimless, diopter, el_field, g_newton, gas_r, heat_cap, k_coulomb, kg, kg m/s, kg/m, m, m/s, m/s^2, mol, ohm, per_kelvin, photon_h, rho_res, s, specific_heat, volume

    entity PointObject { }
    entity ReferenceFrame { }

    fact t_A { unit: A }
    fact t_C { unit: C }
    fact t_F { unit: F }
    fact t_Hz { unit: Hz }
    fact t_J { unit: J }
    fact t_K { unit: K }
    fact t_N { unit: N }
    fact t_N_m { unit: N/m }
    fact t_Pa { unit: Pa }
    fact t_T { unit: T }
    fact t_V { unit: V }
    fact t_W { unit: W }
    fact t_Wb { unit: Wb }
    fact t_area { unit: area }
    fact t_dimless { unit: dimless }
    fact t_diopter { unit: diopter }
    fact t_el_field { unit: el_field }
    fact t_g_newton { unit: g_newton }
    fact t_gas_r { unit: gas_r }
    fact t_heacap { unit: heat_cap }
    fact t_k_coulomb { unit: k_coulomb }
    fact t_kg { unit: kg }
    fact t_kg_m_s { unit: kg m/s }
    fact t_kg_m { unit: kg/m }
    fact t_m { unit: m }
    fact t_m_s { unit: m/s }
    fact t_m_s_2 { unit: m/s^2 }
    fact t_mol { unit: mol }
    fact t_ohm { unit: ohm }
    fact t_per_kelvin { unit: per_kelvin }
    fact t_photon_h { unit: photon_h }
    fact t_rho_res { unit: rho_res }
    fact t_s { unit: s }
    fact t_specific_heat { unit: specific_heat }
    fact t_volume { unit: volume }

    relation alg.solve {
        inputs: { x: t_dimless, val: t_dimless }
        equation: -val + x == 0
        out: x
        # x = val (bind val, leave x free or vice versa)
    }

    relation ckt.current_charge_time {
        inputs: { i: t_A, Q: t_C, t: t_s }
        equation: -Q/t + i == 0
        out: i
        # i = Q / t
    }

    relation ckt.ohms {
        inputs: { v: t_V, i: t_A, r: t_ohm }
        equation: -i*r + v == 0
        out: v
        # Ohm v = i r
    }

    relation ckt.parallel_res {
        inputs: { r: t_ohm, r1: t_ohm, r2: t_ohm }
        equation: -1/r2 - 1/r1 + 1/r == 0
        out: r
        # parallel resistance 1/r = 1/r1 + 1/r2
    }

    relation ckt.power_i2r {
        inputs: { p: t_W, i: t_A, r: t_ohm }
        equation: -i**2*r + p == 0
        out: p
        # joule heating i^2 r
    }

    relation ckt.resistivity {
        inputs: { r: t_ohm, rho: t_rho_res, l: t_m, A: t_area }
        equation: r - l*rho/A == 0
        out: r
        # r = rho l / A
    }

    relation ckt.series_res {
        inputs: { r: t_ohm, r1: t_ohm, r2: t_ohm }
        equation: r - r1 - r2 == 0
        out: r
        # series resistance r = r1 + r2
    }

    relation dyn.circular_centripetal_force {
        inputs: { F: t_N, m: t_kg, v: t_m_s, r: t_m }
        equation: F - m*v**2/r == 0
        out: F
        # centripetal force m v^2 / r
    }

    relation dyn.circular_v_omega_r {
        inputs: { v: t_m_s, omega: t_Hz, r: t_m }
        equation: -omega*r + v == 0
        out: v
        # v = omega r
    }

    relation dyn.fma {
        inputs: { F: t_N, m: t_kg, a: t_m_s_2 }
        equation: F - a*m == 0
        out: F
        # Newton II: F = m a
    }

    relation dyn.friction_kinetic {
        inputs: { f: t_N, mu: t_dimless, N: t_N }
        equation: -N*mu + f == 0
        out: f
        # sliding friction f = mu N
    }

    relation dyn.grav_force {
        inputs: { F: t_N, G: t_g_newton, m1: t_kg, m2: t_kg, r: t_m }
        equation: F - G*m1*m2/r**2 == 0
        out: F
        # Newton gravitation G m1 m2 / r^2
    }

    relation dyn.hooke {
        inputs: { F: t_N, k: t_N_m, x: t_m }
        equation: F - k*x == 0
        out: F
        # Hooke F = k x
    }

    relation dyn.momentum {
        inputs: { p: t_kg_m_s, m: t_kg, v: t_m_s }
        equation: -m*v + p == 0
        out: p
        # momentum p = m v
    }

    relation dyn.normal_force {
        inputs: { N: t_N, F: t_N, theta: t_dimless }
        equation: -F*cos(pi*theta/180) + N == 0
        out: N
        # normal component F cos(theta)
    }

    relation dyn.omega_2pi_T {
        inputs: { omega: t_Hz, T: t_s }
        equation: omega - 2*pi/T == 0
        out: omega
        # angular speed 2 pi / T
    }

    relation dyn.parallel_force {
        inputs: { p: t_N, F: t_N, theta: t_dimless }
        equation: -F*sin(pi*theta/180) + p == 0
        out: p
        # component along incline F sin(theta)
    }

    relation dyn.pendulum_period {
        inputs: { T: t_s, L: t_m, g: t_m_s_2 }
        equation: T - 2*pi*sqrt(L/g) == 0
        out: T
        # pendulum period 2 pi sqrt(L/g)
    }

    relation dyn.shm_omega_k_m {
        inputs: { omega: t_Hz, k: t_N_m, m: t_kg }
        equation: omega - sqrt(k/m) == 0
        out: omega
        # angular frequency sqrt(k/m)
    }

    relation dyn.shm_period_k_m {
        inputs: { T: t_s, k: t_N_m, m: t_kg }
        equation: T - 2*pi*sqrt(m/k) == 0
        out: T
        # period 2 pi sqrt(m/k)
    }

    relation dyn.shm_vmax {
        inputs: { v: t_m_s, omega: t_Hz, A: t_m }
        equation: -A*omega + v == 0
        out: v
        # max SHM speed omega A
    }

    relation dyn.weight {
        inputs: { w: t_N, m: t_kg, g: t_m_s_2 }
        equation: -g*m + w == 0
        out: w
        # weight w = m g
    }

    relation el.cap_energy {
        inputs: { U: t_J, C: t_F, V: t_V }
        equation: -C*V**2/2 + U == 0
        out: U
        # capacitor energy 1/2 C V^2
    }

    relation el.coulomb {
        inputs: { F: t_N, k: t_k_coulomb, q1: t_C, q2: t_C, r: t_m }
        equation: F - k*q1*q2/r**2 == 0
        out: F
        # Coulomb k q1 q2 / r^2
    }

    relation el.field_point {
        inputs: { E: t_el_field, k: t_k_coulomb, Q: t_C, r: t_m }
        equation: E - Q*k/r**2 == 0
        out: E
        # point-charge field k Q / r^2
    }

    relation en.grav_pe {
        inputs: { pe: t_J, m: t_kg, g: t_m_s_2, h: t_m }
        equation: -g*h*m + pe == 0
        out: pe
        # gravitational potential m g h
    }

    relation en.kinetic {
        inputs: { ke: t_J, m: t_kg, v: t_m_s }
        equation: ke - m*v**2/2 == 0
        out: ke
        # kinetic energy 1/2 m v^2
    }

    relation en.power_work_time {
        inputs: { P: t_W, w: t_J, t: t_s }
        equation: -P*t + w == 0
        out: w
        # energy w = P t
    }

    relation en.wet_ke_ke0_work {
        inputs: { ke_f: t_J, ke0: t_J, work: t_J }
        equation: -ke0 + ke_f - work == 0
        out: ke_f
        # work-energy: KE = KE0 + net work
    }

    relation en.work {
        inputs: { W: t_J, F: t_N, d: t_m, theta: t_dimless }
        equation: -F*d*cos(pi*theta/180) + W == 0
        out: W
        # work F d cos(theta)
    }

    relation kin.projectile_max_height {
        inputs: { h: t_m, v: t_m_s, theta: t_dimless, g: t_m_s_2 }
        equation: h - v**2*sin(pi*theta/180)**2/(2*g) == 0
        out: h
        # max height v^2 sin^2(theta)/(2g), theta degrees
    }

    relation kin.projectile_range {
        inputs: { R: t_m, v: t_m_s, theta: t_dimless, g: t_m_s_2 }
        equation: R - v**2*sin(pi*theta/90)/g == 0
        out: R
        # range v^2 sin(2 theta)/g, theta in degrees
    }

    relation kin.suvat_s_s0_vt {
        inputs: { s: t_m, s0: t_m, v: t_m_s, t: t_s }
        equation: s - s0 - t*v == 0
        out: s
        # s = s0 + v t
    }

    relation kin.suvat_s_ut_athalf {
        inputs: { s: t_m, u: t_m_s, a: t_m_s_2, t: t_s }
        equation: -a*t**2/2 + s - t*u == 0
        out: s
        # s = u t + 1/2 a t^2
    }

    relation kin.suvat_v_u_at {
        inputs: { v: t_m_s, u: t_m_s, a: t_m_s_2, t: t_s }
        equation: -a*t - u + v == 0
        out: v
        # v = u + a t
    }

    relation kin.v2_u2_2 {
        inputs: { v: t_m_s, u: t_m_s, a: t_m_s_2, s: t_m }
        equation: -2*a*s - u**2 + v**2 == 0
        out: v
        # v^2 = u^2 + 2 a s
    }

    relation mag.emf_motion {
        inputs: { emf: t_V, B: t_T, L: t_m, v: t_m_s }
        equation: -B*L*v + emf == 0
        out: emf
        # motional EMF B L v
    }

    relation mag.flux_change_emf {
        inputs: { emf: t_V, N: t_dimless, dPhi: t_Wb, dt: t_s }
        equation: -N*dPhi/dt + emf == 0
        out: emf
        # induced EMF N dPhi/dt
    }

    relation mag.force_charge {
        inputs: { F: t_N, q: t_C, v: t_m_s, B: t_T }
        equation: -B*q*v + F == 0
        out: F
        # force on charge q v B (perpendicular)
    }

    relation mag.force_wire {
        inputs: { F: t_N, B: t_T, i: t_A, L: t_m }
        equation: -B*L*i + F == 0
        out: F
        # force on wire B i L (perpendicular)
    }

    relation mod.binding_energy {
        inputs: { E: t_J, dm: t_kg, c: t_m_s }
        equation: E - c**2*dm == 0
        out: E
        # binding energy dm c^2
    }

    relation mod.debroglie {
        inputs: { lam: t_m, h: t_photon_h, p: t_kg_m_s }
        equation: -h/p + lam == 0
        out: lam
        # de Broglie lambda = h / p
    }

    relation mod.diode_current {
        inputs: { v: t_V, i: t_A, r: t_ohm }
        equation: -i*r + v == 0
        out: r
        # linear diode operating point v = i r
    }

    relation mod.half_life {
        inputs: { N: t_dimless, N0: t_dimless, t: t_s, T: t_s }
        equation: N - N0/2**(t/T) == 0
        out: N
        # N = N0 2^(-t/T)
    }

    relation mod.hydrogen_en {
        inputs: { E: t_dimless, n: t_dimless }
        equation: E + 13.6/n**2 == 0
        out: E
        # hydrogen level -13.6/n^2 (values in eV, kept numeric)
    }

    relation mod.photoelectric {
        inputs: { E: t_J, h: t_photon_h, f: t_Hz, phi: t_J }
        equation: E - f*h + phi == 0
        out: E
        # KE = h f - phi
    }

    relation mod.photon_energy {
        inputs: { E: t_J, h: t_photon_h, f: t_Hz }
        equation: E - f*h == 0
        out: E
        # photon E = h f
    }

    relation opt.critical {
        inputs: { n1: t_dimless, n2: t_dimless, tc: t_dimless }
        equation: sin(pi*tc/180) - n2/n1 == 0
        out: tc
        # sin tc = n2/n1, tc in degrees
    }

    relation opt.magnification {
        inputs: { m: t_dimless, v: t_m, u: t_m }
        equation: m - v/u == 0
        out: m
        # linear magnification v/u (signed by convention)
    }

    relation opt.mirror_lens {
        inputs: { f: t_m, v: t_m, u: t_m }
        equation: -1/v - 1/u + 1/f == 0
        out: f
        # 1/f = 1/v + 1/u
    }

    relation opt.power {
        inputs: { P: t_diopter, f: t_m }
        equation: P - 1/f == 0
        out: P
        # lens power P = 1/f
    }

    relation opt.snell {
        inputs: { n1: t_dimless, n2: t_dimless, t1: t_dimless, t2: t_dimless }
        equation: n1*sin(pi*t1/180) - n2*sin(pi*t2/180) == 0
        out: t2
        # Snell n1 sin t1 = n2 sin t2; angles in degrees
    }

    relation th.expansion_len {
        inputs: { dl: t_m, alpha: t_per_kelvin, L0: t_m, dT: t_K }
        equation: -L0*alpha*dT + dl == 0
        out: dl
        # linear expansion alpha L0 dT
    }

    relation th.first_law_delta_u {
        inputs: { U: t_J, Q: t_J, W: t_J }
        equation: -Q + U + W == 0
        out: U
        # first law: dU = Q - W
    }

    relation th.pv_nrt {
        inputs: { P: t_Pa, V: t_volume, n: t_mol, R: t_gas_r, T: t_K }
        equation: P*V - R*T*n == 0
        out: V
        # ideal gas P V = n R T
    }

    relation th.q_mc_dt {
        inputs: { Q: t_J, m: t_kg, c: t_specific_heat, dT: t_K }
        equation: Q - c*dT*m == 0
        out: Q
        # sensible heat m c dT
    }

    relation th.q_ml {
        inputs: { Q: t_J, m: t_kg, L: t_heacap }
        equation: -L*m + Q == 0
        out: Q
        # latent heat m L
    }

    relation vec.components {
        inputs: { F: t_N, theta: t_dimless, vx: t_N, vy: t_N }
        equation: -F*cos(pi*theta/180) + vx == 0
        out: vx
        # horizontal component F cos(theta), theta in degrees
    }

    relation vec.resultant_pythagoras {
        inputs: { f1: t_N, f2: t_N, F: t_N }
        equation: F - sqrt(f1**2 + f2**2) == 0
        out: F
        # perpendicular resultant |R| = sqrt(f1^2 + f2^2)
    }

    relation w.fundamental_freq {
        inputs: { f: t_Hz, v: t_m_s, L: t_m }
        equation: f - v/(2*L) == 0
        out: f
        # fundamental string f = v/(2L)
    }

    relation w.speed_freq_len {
        inputs: { v: t_m_s, f: t_Hz, lam: t_m }
        equation: -f*lam + v == 0
        out: v
        # wave speed f lambda
    }

    relation w.string_speed_tension {
        inputs: { v: t_m_s, T: t_N, mu: t_kg_m }
        equation: v - sqrt(T/mu) == 0
        out: v
        # string wave speed sqrt(T/mu)
    }

}
