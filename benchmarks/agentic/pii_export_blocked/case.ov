# Policy: never export a table holding personal data to an external destination.
package bench.pii_export_blocked
type Plan
type Action
type Thing
predicate plan(p: Plan) world closed
predicate step(p: Plan, i: Number, a: Action, x: Thing) world closed
predicate violation(p: Plan, i: Number) world closed
predicate violates(p: Plan) world closed
predicate valid(p: Plan) world closed
axiom any_violation(p: Plan, i: Number): violation(p, i) -> violates(p)
axiom valid_plan(p: Plan): plan(p), not violates(p) -> valid(p)
predicate personal_data(x: Thing) world closed
entity export_external, read: Action
axiom pii_export(p: Plan, i: Number, x: Thing):
  step(p, i, export_external, x), personal_data(x) -> violation(p, i)

test pii_export_blocked {
  scenario pii_export_blocked_s uses bench.pii_export_blocked {
    entity report: Plan
    entity customers, metrics: Thing
    fact plan(report)
    fact personal_data(customers)
    fact step(report, 1, read, customers)
    fact step(report, 2, export_external, customers)
    fact step(report, 3, export_external, metrics)
    query PROVE valid(report)
    query FIND ?i WHERE violation(report, ?i)
  }
}
