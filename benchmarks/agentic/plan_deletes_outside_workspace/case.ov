# Plan verification. Policy: never delete a file outside the workspace.
# Step 2 deletes /etc/hosts, so the plan is invalid, and the violating step is 2.
package bench.plan_deletes_outside_workspace
import agent.workflow

predicate in_workspace(f: Target) world closed

entity delete, read: Tool

axiom outside_delete(p: Plan, i: Number, f: Target):
  step(p, i, delete, f), not in_workspace(f) -> violation(p, i)

test plan_deletes_outside_workspace {
  scenario plan_deletes_outside_workspace_s uses bench.plan_deletes_outside_workspace {
    entity cleanup: Plan
    entity notes, hosts: Target
    fact plan(cleanup)
    fact in_workspace(notes)
    fact step(cleanup, 1, read, hosts)
    fact step(cleanup, 2, delete, hosts)
    fact step(cleanup, 3, delete, notes)
    query PROVE valid(cleanup)
    query FIND ?i WHERE violation(cleanup, ?i)
  }
}
