  "claims": [
    {
      "id": "claim_a830a845f49a47f99897cd6fef449eeb",
      "statement": "OpenVerifiers is packaged as three strict layers — SDK core, thin CLI, and a designed MCP server — with the boundary rule that domain adapters must not leak the core's internals through CLI or MCP; this packaging is a finalized v1 decision.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L255-L258",
          "version": "repo-lines-v1:sha256:c81a8c1a84aafa3a2fc282d6b0cecc1d32973b344ff003aa5554104417a0a5d7:"
