# Policy: never export a table holding personal data to an external destination.
package bench.pii_export_blocked
import agent.workflow
predicate personal_data(x: Target) world closed
entity export_external, read: Tool
axiom pii_export(p: Plan, i: Number, x: Target):
  step(p, i, export_external, x), personal_data(x) -> violation(p, i)

test pii_export_blocked {
  scenario pii_export_blocked_s uses bench.pii_export_blocked {
    entity report: Plan
    entity customers, metrics: Target
    fact plan(report)
    fact personal_data(customers)
    fact step(report, 1, read, customers)
    fact step(report, 2, export_external, customers)
    fact step(report, 3, export_external, metrics)
    query PROVE valid(report)
    query FIND ?i WHERE violation(report, ?i)
  }
}
