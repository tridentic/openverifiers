  "claims": [
    {
      "id": "claim_12f83f51e6d94e299b63836ac35e102c",
      "statement": "The solver layer (solvers.py) owns the dimension algebra and the solver registry/backends, and its design contract is to stay backend-agnostic: the core engine never imports sympy directly.",
      "evidence": [
        {
          "resource": "repo://solvers.py#L1-L10",
          "version": "repo-lines-v1:sha256:b4e7b40c1d39dd7e4ed11a568cb0337f65f36976558c19be2c704bf91b3e2765:"
        }
      ]
    },
    {
      "id": "claim_7c08ee6534a34b5eb643ee488ee89bea",
      "statement": "A dimension is an ADT: a dict of {L, M, T} basis-symbol exponents, with the shipped constants DIM, D_LENGTH, D_TIME, D_VELOCITY, D_ACCEL, D_FORCE, D_MASS, D_ENERGY.",
      "evidence": [
        {
          "resource": "repo://solvers.py#L17-L29",
          "version": "repo-lines-v1:sha256:7a0c889de3f81ea65812d4e93acaa701dfb37b77c47e1980aa4ff1201d261fac:"
        }
      ]
    },
    {
      "id": "claim_9ece69e432194af8898b81d30d5e0e14",
      "statement": "dim_add sums exponents pointwise and drops basis symbols whose resulting exponent is zero; dim_sub is dim_add against the negated dict; dim_eq compares dicts after dropping zero exponents, so missing keys equal exponent 0 and dicts compare order-insensitively.",
      "evidence": [
        {
          "resource": "repo://solvers.py#L32-L44",
          "version": "repo-lines-v1:sha256:99e5b2b157160b0e0c47ff1a88b3cc8b0bbcc23800686c8944fc4a13e20b5dfe:"
        }
      ]
    },
    {
      "id": "claim_7aba43ef4c974337ae97b579fe26b17b",
      "statement": "The physics grammar stamps a dimension constant into every fact's attributes['dimension'] and make_rule's generated precondition rejects a firing with a reason string when dim_eq fails against the expected kind's dimension, matching ARCHITECTURE.md §8's requirement that dimension checking is enforced on every rule with recorded rejection reasons.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L326-L328",
          "version": "repo-lines-v1:sha256:ae7681bc93f993633202aef9798e150836d9a7388a941552d0c80b3c9005d0f6:"
