# Policy: never write a secret to a log.
package bench.secret_in_log
import agent.workflow
predicate secret(x: Target) world closed
entity log_write, use: Tool
axiom leak(p: Plan, i: Number, x: Target): step(p, i, log_write, x), secret(x) -> violation(p, i)

test secret_in_log {
  scenario secret_in_log_s uses bench.secret_in_log {
    entity debug: Plan
    entity api_key, status: Target
    fact plan(debug)
    fact secret(api_key)
    fact step(debug, 1, use, api_key)
    fact step(debug, 2, log_write, api_key)
    fact step(debug, 3, log_write, status)
    query FIND ?i WHERE violation(debug, ?i)
  }
}
