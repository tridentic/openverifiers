# Policy: delete a table only after an earlier backup step of it.
package bench.delete_before_backup
type Plan
type Action
type Thing
predicate plan(p: Plan) world closed
predicate step(p: Plan, i: Number, a: Action, x: Thing) world closed
predicate violation(p: Plan, i: Number) world closed
predicate violates(p: Plan) world closed
predicate valid(p: Plan) world closed
axiom any_violation(p: Plan, i: Number): violation(p, i) -> violates(p)
axiom valid_plan(p: Plan): plan(p), not violates(p) -> valid(p)
entity backup, delete: Action
predicate backed_up_before(p: Plan, i: Number, x: Thing) world closed
axiom earlier_backup(p: Plan, i: Number, j: Number, x: Thing):
  step(p, j, backup, x), step(p, i, delete, x), j < i -> backed_up_before(p, i, x)
axiom unsafe_delete(p: Plan, i: Number, x: Thing):
  step(p, i, delete, x), not backed_up_before(p, i, x) -> violation(p, i)

test delete_before_backup {
  scenario delete_before_backup_s uses bench.delete_before_backup {
    entity cleanup: Plan
    entity old_logs: Thing
    fact plan(cleanup)
    fact step(cleanup, 1, delete, old_logs)
    fact step(cleanup, 2, backup, old_logs)
    query PROVE valid(cleanup)
    query FIND ?i WHERE violation(cleanup, ?i)
  }
}
