  "claims": [
    {
      "id": "claim_0d795268d0874a31adc9eacf4d157aea",
      "statement": "The engine implements both reasoning modes — backward deduction and forward induction — over one Transformation definition per relationship; the same precondition and dimension checks run in both directions, with backward search implemented as goal refinement over the same fact store, never as a separate forward/backward model pair [v1].",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L107-L114",
          "version": "repo-lines-v1:sha256:d9031430b0c15ed63499d8c0623013bc5f1c91869f3dfd0054bf4d5156ceb62a:"
        },
        {
          "resource": "repo://ARCHITECTURE.md#L82-L85",
          "version": "repo-lines-v1:sha256:dda49031c6bc363ca0e986833b9c8ab90543588bed67d13d732845e53914d8d8:"
        },
        {
          "resource": "repo://engine.py#L1-L19",
          "version": "repo-lines-v1:sha256:859b33b050ab6f1232736afd06ed053259dac1366b8f3655c46034ffaa3a863f:"
        }
      ]
    },
    {
      "id": "claim_7f566d2d26f44cfa9d3553f3f6ce6c61",
      "statement": "An Engine instance owns the entire run state — rules, one verbose trace list, a fact store keyed by id, parent/child DAG edge sets, a per-kind memo, and a rule index built by output kind in the constructor (_by_kind) — so backward search looks up exactly the rules that can produce a goal kind instead of scanning the library.",
      "evidence": [
        {
          "resource": "repo://engine.py#L59-L71",
          "version": "repo-lines-v1:sha256:649b6f62739edb0195c541b87bdd51322b44e8cce171ec2677106f7686869b43:"
        }
      ]
    },
    {
      "id": "claim_d257753735404d048eb2ffdb70ad6e84",
      "statement": "Fact identity is the DAG deduplication key: Engine.add_fact returns the existing fact when an id collides instead of inserting a second node, so any two attempts that produce the same fact collapse into one node by construction [v1].",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L125-L128",
          "version": "repo-lines-v1:sha256:bd3e89ea147453dd3a02b2ee8ba524fe4539c9cac1d76c7f55e7b4d434bbe625:"
        },
        {
          "resource": "repo://engine.py#L74-L81",
          "version": "repo-lines-v1:sha256:7a6cc30385252590d11d7e6358dd3c079155a0ae1c887b6589a9d43e775b7929:"
        }
      ]
    },
    {
      "id": "claim_b36d4fa2b83e4acd8c0564e923379b38",
      "statement": "Fact is a frozen dataclass, so derivation always creates new facts and never mutates an existing node; this immutability is what lets one fact safely serve as a premise for many rules and many subproblems in the shared DAG.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L142-L144",
          "version": "repo-lines-v1:sha256:2e3bf8978e35b4bd9e5ea23c9a5a33a90e0d872c27a94ecc1f3dc879d6ba8aaf:"
        },
        {
          "resource": "repo://model.py#L30-L37",
