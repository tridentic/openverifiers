    {
      "id": "claim_c6d4fc944a2543f3b45b1122618b045d",
      "statement": "render_view is the single text render path: it maps the view name to one of result.success_path/failure_trail/full, raises ValueError('unknown view ...') for any other name, and emits a header line plus one deterministic line per event type (derive, REJECT with reason, deadend with kind and reason, join with sources, UNKNOWN with reason and optional evidence suffix). It is exported from the package, delegated to by VerificationResult.render(view), and used by the CLI.",
      "evidence": [
        {
          "resource": "repo://__init__.py#L13-L17",
          "version": "repo-lines-v1:sha256:a7dc91ffef749bab49ec09d82931b64e5ebc90383d36c298525faf82ba64a25a:"
