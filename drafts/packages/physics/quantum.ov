# DRAFT (MP-DOL): AI-drafted library lines, not approved by the founder. Loaded only by
# `ov run --drafts` / `ov exam --drafts`; results that use it are provisional.
#
# physics.quantum: matter waves and the Bohr model.
package physics.quantum @0.1-draft

# de Broglie: a particle of momentum p (magnitude) has wavelength h / p.
fact type MatterWave {
  property h: "J*s"
  property p: Momentum
  property wavelength: Length
  invariant positive: h > 0 p > 0
  law de_broglie: wavelength * p = h
}

# A free non-relativistic particle of mass m and kinetic energy E has
# momentum p with p^2 = 2 m E (definition of kinetic energy, E = p^2 / 2m).
fact type SlowParticle extends MatterWave {
  property m: Mass
  property energy: Energy
  invariant mass_positive: m > 0
  invariant kinetic_energy: p * p = 2 * m * energy
}

# Bohr model of a hydrogen-like atom of atomic number Z: in orbit n the
# electron's orbit radius is n^2 a0 / Z (a0: the first Bohr radius of hydrogen)
# and its angular momentum p r is quantized as n h / (2 pi).
fact type BohrOrbit extends MatterWave {
  property n: Real
  property Z: Real
  property a0: Length
  property r: Length
  invariant orbit_positive: n >= 1 Z >= 1 a0 > 0
  law orbit_radius: r * Z = n * n * a0
  law angular_momentum: 2 * pi * p * r = n * h
  # The orbit holds a whole number of wavelengths.
  theorem standing_wave: n * wavelength = 2 * pi * r
}
