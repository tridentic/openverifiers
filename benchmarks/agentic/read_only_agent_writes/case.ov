# Policy: an agent with a read-only role may not write.
package bench.read_only_agent_writes
type Plan
type Action
type Thing
predicate plan(p: Plan) world closed
predicate step(p: Plan, i: Number, a: Action, x: Thing) world closed
predicate violation(p: Plan, i: Number) world closed
predicate violates(p: Plan) world closed
predicate valid(p: Plan) world closed
axiom any_violation(p: Plan, i: Number): violation(p, i) -> violates(p)
axiom valid_plan(p: Plan): plan(p), not violates(p) -> valid(p)
type Agent
predicate runs(p: Plan, ag: Agent) world closed
predicate read_only(ag: Agent) world closed
entity write, read: Action
axiom ro_write(p: Plan, i: Number, x: Thing, ag: Agent):
  step(p, i, write, x), runs(p, ag), read_only(ag) -> violation(p, i)

test read_only_agent_writes {
  scenario read_only_agent_writes_s uses bench.read_only_agent_writes {
    entity audit: Plan
    entity viewer: Agent
    entity ledger: Thing
    fact plan(audit)
    fact runs(audit, viewer)
    fact read_only(viewer)
    fact step(audit, 1, read, ledger)
    fact step(audit, 2, write, ledger)
    query PROVE valid(audit)
    query FIND ?i WHERE violation(audit, ?i)
  }
}
