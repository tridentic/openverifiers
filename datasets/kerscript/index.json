{
  "dataset": "kerscript-v1",
  "version": 2,
  "files": ["physics.json", "maths.json", "math.json", "logic.json",
            "law.json", "business.json", "english.json"],
  "note": "Every entry: plain-English problem, context (premise facts), a declared target query, a KDScript-Proof attempt, and the expected verdict/values. The acceptance bar: run each attempt against the compiled opk grammars and match the expected result.",
  "entry_schema": {
    "id": "unique per domain",
    "domain": "physics|math|logic|law|business|english",
    "topics": ["topic tags"],
    "difficulty": "easy|medium|hard",
    "problem": "plain english problem statement",
    "context": {"fact_id": {"kind": "quantity|action", "value": "...",
                            "unit": "token", "kind_name": "...", "of": "..."}},
    "target": {"id": "produced fact id", "value": "number|string|null"},
    "proof": "KDScript-Proof attempt text",
    "expected": {"id": "produced fact id", "value": "number|string|null"},
    "must_fail": true
  }
}