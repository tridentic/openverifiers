    {
      "id": "claim_03a4f9897cf04646ada072e0a92f3d99",
      "statement": "cli.py is a thin wrapper over the SDK: main() parses argv, splits --explicit into a dict, makes exactly one SDK call verify_physics(args.problem, explicit=..., explicit_target=...), then prints result.render(view) or a JSON summary of status/answer/target and the three view lengths; it imports only argparse, json, sys, and verify_physics, never engine/model/trace, so it cannot touch DAG internals or the rule store.",
      "evidence": [
        {
          "resource": "repo://cli.py#L13-L17",
