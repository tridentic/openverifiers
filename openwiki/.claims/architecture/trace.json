  "claims": [
    {
      "id": "claim_d475754605e744579cf5eaae2517c64d",
      "statement": "OpenVerifiers' trace policy is one verbose store, three views: the engine appends every derive, reject, deadend, join, and unknown event at search time to a single list (Engine.trace) and throws nothing away; success-path, failure-trail, and full are render-time projections of that one store computed by build_views, never separate structures (ARCHITECTURE.md §4).",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L148-L174",
          "version": "repo-lines-v1:sha256:70dcffa268f0719f6c4abd59b4d0230afb6c0d3b179d1bf0eefe130c143ebec7:"
        },
        {
          "resource": "repo://docs/design.md#L69-L72",
          "version": "repo-lines-v1:sha256:9c2991b6184b9a96c286edc1e54d6e2d49973f5333ce887b8f50907fffdb0129:"
        },
        {
          "resource": "repo://engine.py#L59-L63",
          "version": "repo-lines-v1:sha256:6475219172834ef652734c2c673ce7439d1ec88036f71c2d0803b242dabcfced:"
        },
        {
          "resource": "repo://trace.py#L1-L11",
          "version": "repo-lines-v1:sha256:446e6d8146b6f25657e2d14f0bd61de77bc70bcc8bc505bb34d78b3cde87fc29:"
        }
      ]
    },
    {
      "id": "claim_be5ae14bbecf4361aefe613e53a55e2b",
      "statement": "engine.py emits exactly five trace event shapes via ev_derive, ev_reject, ev_deadend, ev_join, and ev_unknown: derive carries type/fact_id/fact_value(str)/rule/inputs(list of input fact ids); reject carries type/rule/inputs/reason; deadend carries type/fact_kind/reason; join carries type/fact_id/sources; unknown carries type/fact_id/reason/evidence. No other event type exists in the store.",
      "evidence": [
        {
          "resource": "repo://engine.py#L35-L53",
          "version": "repo-lines-v1:sha256:5f07f610323eabea606ee4e0d658aedac786bc967a2278f36f21e0d238ae6789:"
        }
      ]
    },
    {
      "id": "claim_63401ab2aaa9472c9f13bea2b8945587",
      "statement": "Engine._record_derive appends the derive trace event and maintains the _parents/_children DAG edge sets in the same place, so the graph structure and the audit trail can never diverge.",
      "evidence": [
        {
          "resource": "repo://engine.py#L83-L87",
          "version": "repo-lines-v1:sha256:b9f6a2574d5d028fd919c094e94486f939701d375ab0a5459edc62736a633172:"
        }
      ]
    },
    {
      "id": "claim_5bc9c93f152a47c7b0eb3dbb7b0d6426",
      "statement": "build_views(trace, target_id, answer) is the only projection function; it is called once at result construction in Engine._result, and the returned (success, failure, full) lists are stored on VerificationResult as success_path, failure_trail, and full.",
      "evidence": [
        {
          "resource": "repo://engine.py#L252-L256",
          "version": "repo-lines-v1:sha256:8fae8c717895c599cee95c390d2a3f842ba89fe6cf9a639a87a462c22b7a0c0c:"
        },
        {
