        }
      ]
    },
    {
      "id": "claim_d2594ad7cb29490e8924ada46ff39a76",
      "statement": "The failure-trail view is the success path plus every reject, deadend, and unknown event in trace order, deduplicated by object identity; join events are not included in the failure trail.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L167-L170",
