    {
      "id": "claim_1f90184f4b5e4b589537f26fcfd282bd",
      "statement": "Reject events record the why: the deduction visiting-set circular guard ('circular: kind ... already on path'), the ancestor guard ('circular: ... in ancestors of inputs'), grammar precondition reasons (dimension mismatch, arity), and 'relation error: ...' when rule.apply raises; induction records precondition and relation-error rejects per candidate but skips a circular candidate silently rather than recording a rejection — the one asymmetry in the event stream.",
      "evidence": [
        {
          "resource": "repo://engine.py#L110-L112",
          "version": "repo-lines-v1:sha256:4c15daaf1624b886e7f2f48ecc0138b3871580f1e6a12e2bcc3a57ebc5096b81:"
